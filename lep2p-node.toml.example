listen = "0.0.0.0:12345"
keyfile = "node.key"
seeds = ["_lep2p.n1ko.dev"]
relay = { enabled = false, methods = [] }

# TUN overlay (milestone 2). Requires CAP_NET_ADMIN (run as root) and the
# kernel `tun` module (`sudo modprobe tun`).
[overlay]
enabled = false
name = "lep2p0"
mtu = 1420
# Peers to attach directly at startup: "<node_id_base32>@<ip:port>".
peers = []

# Optional: reach peers through a relay node. Packets are end-to-end
# encrypted; the relay only forwards opaque blobs.
# relay = "<node_id_base32>@<ip:port>"
# relay_peers = ["<node_id_base32>"]
